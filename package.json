{
  "name": "ai-ugc-maker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "cd server && node src/index.js",
    "dev:web": "cd web && npm run dev",
    "build": "cd web && npm run build",
    "start": "cd server && node src/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
