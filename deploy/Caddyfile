# Reverse proxy for the first production deployment (Phase 4 of
# docs/plans/aws-production-hosting-cicd.md). No domain yet -> DOMAIN
# defaults to :80 (docker-compose.production.yml), plain HTTP on the bare
# Elastic IP, no automatic HTTPS attempt (Caddy only does ACME for an actual
# domain name — a fake placeholder here would just fail certificate issuance
# on a loop). Once DNS points a real domain at the instance, set DOMAIN to
# it and restart Caddy: it gets and renews the Let's Encrypt cert for free.
{$DOMAIN::80} {
	encode gzip

	# Recommended for a first deployment: since server/src/auth.js gates
	# /api/* with a single shared bearer token (awkward for a browser
	# session — video/thumbnail <img>/<video> tags can't send custom
	# headers), gate the WHOLE site with HTTP Basic Auth at the edge
	# instead, and leave API_AUTH_TOKEN unset. Generate a hash with:
	#   caddy hash-password --plaintext '<your-password>'
	# basicauth {
	# 	<username> <bcrypt-hash>
	# }

	reverse_proxy app:8787 {
		# Large MP4 uploads/downloads: keep the proxy from buffering the
		# whole body in memory.
		flush_interval -1
	}

	# Harmless over plain HTTP — browsers ignore Strict-Transport-Security
	# unless it arrives over an actual HTTPS connection, so this becomes
	# live the moment DOMAIN is set to a real domain, no other change needed.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}
