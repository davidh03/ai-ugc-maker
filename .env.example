# Copy to server/.env for local dev, or set these as real environment
# variables in production (Docker Compose env_file / AWS Secrets Manager /
# SSM Parameter Store). Never commit a filled-in .env — see .gitignore.

# --- Server ---
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
NODE_ENV=development

# Bearer token required on all /api/* routes except /api/health and
# /api/ready. Leave unset for local dev. REQUIRED before exposing this
# server on the public internet — see docs/deploy/README.md.
API_AUTH_TOKEN=

# --- Composition ---
COMPOSER=template
MAX_DURATION_SEC=180
AI_REVIEWER_MAX_ITERATIONS=

# --- Voiceover providers (only the ones you use need a key) ---
OPENAI_API_KEY=
GOOGLE_TTS_API_KEY=
MINIMAX_API_KEY=
CARTESIA_API_KEY=

# --- Agent composer (composer=agent) and Luna image analysis ---
# These shell out to locally installed, OAuth-authenticated CLIs. They are
# NOT bundled by deploy/Dockerfile — composer=template (the default) does
# not need them. See "Agent composer / Luna in production" in
# docs/deploy/README.md before relying on agent-mode generation in AWS.
CODEX_BIN=
OPENCODE_BIN=
ENABLE_LUNA_IMAGE_ANALYSIS=true

# --- Misc ---
TRANSCRIPTS_ENABLED=true
